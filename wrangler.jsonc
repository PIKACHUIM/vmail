{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempmail-work",
  "main": "worker/src/index.ts",

  // 打包配置
  "minify": true,
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-10-18",
  "keep_vars": true,

  // D1 数据库（本实例的实际值，因此 `wrangler deploy` 可直接部署；
  // 走 `pnpm run deploy` 时 scripts/configure.mjs 会按 .env 重新渲染 wrangler.deploy.jsonc）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tempmail-data",
      "database_id": "31ecf85e-07a0-4f24-97f9-8fe3c6ab5d51",
      "migrations_dir": "worker/drizzle"
    }
  ],

  // 普通变量。密钥不写在这里：TURNSTILE_SECRET / MAILBOX_TOKEN_SECRET / RESEND_API_KEY /
  // GITHUB_CLIENT_SECRET / BETTER_AUTH_SECRET / API_KEY_SECRET 一律用 wrangler secret 管理
  "vars": {
    "PASSWORD": "",
    "EMAIL_DOMAIN": "524228.xyz",
    "SEND_CHANNEL": "resend",
    "SENDER_EMAIL": "noreply@emails.524228.xyz",
    "SEND_USER_DAILY_LIMIT": "10",
    "SEND_GLOBAL_DAILY_LIMIT": "100",
    "SEND_RATE_LIMIT_PER_MINUTE": "3",
    "SEND_IP_RATE_LIMIT_PER_MINUTE": "10",
    "TURNSTILE_KEY": "0x4AAAAAAA3GOUwP4K5-UT6j",
    "API_RATE_LIMIT_PER_MINUTE": "30",
    "SHOW_AFF": "false",
    "ENABLE_OPENAPI": "false",
    "BETTER_AUTH_URL": "https://mailer.524228.xyz",
    "API_DAILY_LIMIT": "1000",
    "MAILBOX_DAILY_LIMIT": "20",
    "MAX_ACTIVE_MAILBOXES": "20",
    "GLOBAL_API_DAILY_LIMIT": "100000",
    "GLOBAL_INBOUND_DAILY_LIMIT": "100000",
    "MAILBOX_INBOUND_DAILY_LIMIT": "100",
    "MAX_EMAIL_BYTES": "262144",
    "SUSPEND_DATABASE_ACCESS": "false"
  },

  // Cloudflare 原生邮件发送绑定
  "send_email": [{ "name": "SEND_EMAIL" }],

  // 每小时运行一次清理任务
  "triggers": { "crons": ["0 * * * *"] },

  "build": { "command": "pnpm run build" },

  "assets": {
    "binding": "ASSETS",
    "directory": "frontend/build/client"
  },

  "durable_objects": {
    "bindings": [{ "name": "ACCESS", "class_name": "AccessLedger" }]
  },

  "migrations": [
    { "tag": "v1-access-ledger", "new_sqlite_classes": ["AccessLedger"] }
  ],

  "ratelimits": [
    { "name": "EDGE_IP", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "EDGE_KEY", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true, "head_sampling_rate": 0.01 }

  // Free 计划不支持 CPU 限制；升级 Workers Paid 后可加回：
  // "limits": { "cpu_ms": 100 }
}
